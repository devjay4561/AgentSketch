{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "AgentSketch",
  "outputfilename": "AgentSketch",
  "frontend:dir": ".",
  "frontend:install": "npm ci",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "wailsjsdir": ".",
  "author": { "name": "AgentSketch", "email": "" },
  "info": {
    "companyName": "AgentSketch",
    "productName": "AgentSketch",
    "productVersion": "0.1.1",
    "copyright": "Copyright (c) 2026 AgentSketch contributors. MIT License.",
    "comments": "오프라인 플로우차트 편집기",
    "fileAssociations": [
      { "ext": "agentsketch", "name": "AgentSketch document", "description": "AgentSketch flowchart document", "iconName": "appicon", "role": "Editor" },
      { "ext": "flowpaper", "name": "AgentSketch legacy document", "description": "Legacy FlowPaper document", "iconName": "appicon", "role": "Editor" }
    ]
  }
}
