{
  "name": "agentsketch-desktop",
  "private": true,
  "version": "0.1.1",
  "description": "Offline flowchart editor for Windows — map sources, prerequisites and processes on one canvas.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devjay4561/AgentSketch.git"
  },
  "homepage": "https://github.com/devjay4561/AgentSketch#readme",
  "bugs": "https://github.com/devjay4561/AgentSketch/issues",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "test:ui": "node scripts/e2e-check.mjs && node scripts/editor-regressions.mjs",
    "test:performance": "node scripts/perf-check.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.64.1",
    "pptxgenjs": "^4.0.0"
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
